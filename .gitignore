# macOS / exFAT metadata
._*
.DS_Store

# Build artifacts
build/
*.raw
*.bin
*.zip

# PlatformIO（备用构建，见 platformio.ini）
.pio/

# Local assets (generated on demand)
tools/fonts/*.otf
tools/samples/

# Assistant runtime state (per-host config, generated on first save)
assistant/assistant_config.json
assistant/assistant_config.json.tmp
assistant/nohup.out
assistant/assistant.log
assistant/app.ico

# PyInstaller（tools/build_exe.bat 的产物）
assistant/build/
assistant/dist/
assistant/*.spec

# Python caches
__pycache__/
*.pyc
